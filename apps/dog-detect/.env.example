# CVAT (scripts/up-cvat.ps1 로 띄운 뒤 createsuperuser 계정)
CVAT_HOST=http://localhost:8080
CVAT_USERNAME=admin
CVAT_PASSWORD=
# 비밀번호 대신 Personal Access Token을 쓸 수 있습니다. 있으면 비밀번호보다 우선합니다.
CVAT_ACCESS_TOKEN=

# gpu --fix 가 받는 PyTorch 휠 인덱스. Blackwell(sm_120)은 CUDA 12.8 이상이 필요합니다.
TORCH_INDEX_URL=https://download.pytorch.org/whl/cu128
